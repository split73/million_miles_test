{
  "projectSettings": {
    "framework": "services"
  },
  "services": {
    "frontend": {
      "entrypoint": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "entrypoint": "backend"
    }
  },
  "rewrites": [
    {
      "source": "/_ /backend/(.*)",
      "destination": "/_ /backend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}